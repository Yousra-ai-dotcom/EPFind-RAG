# ===== Azure OpenAI (LLM + embeddings) =====
AZURE_OPENAI_ENDPOINT=https://<votre-ressource>.openai.azure.com
AZURE_OPENAI_KEY=<votre-cle>
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ===== Azure AI Search =====
AZURE_SEARCH_ENDPOINT=https://<votre-service>.search.windows.net
AZURE_SEARCH_KEY=<votre-cle-admin>
AZURE_SEARCH_INDEX=epf-courses-index

# ===== Azure Blob Storage =====
AZURE_STORAGE_CONNECTION_STRING=<votre-connection-string>
AZURE_STORAGE_CONTAINER=courses

# ===== Microsoft Entra ID (login EPF) =====
ENTRA_TENANT_ID=<tenant-id>
ENTRA_CLIENT_ID=<client-id-backend>
ENTRA_CLIENT_SECRET=<client-secret-si-besoin>

# ===== Base de données =====
DATABASE_URL=postgresql://epf:epf@localhost:5432/epf_find

# ===== Backend =====
FRONTEND_URL=http://localhost:3000
EPF_COURSES=Machine Learning,Chatbot,Big Data,Blockchain,Java,DevOps

# ===== Frontend (dans frontend/.env.local, PAS ici) =====
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_ENTRA_CLIENT_ID=<client-id-frontend>
# NEXT_PUBLIC_ENTRA_TENANT_ID=<tenant-id>